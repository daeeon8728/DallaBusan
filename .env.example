# Trip Fit local server settings.
# Enter credentials here. Never commit this file or use VITE_ for secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Busan AttractionService: paste the issued key without URL-encoding it again.
ATTRACTION_SERVICE_KEY=

# AI skeleton provider (choose the provider/model when implementing the adapter).
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Optional exchange provider. Frankfurter does not require a key.
EXCHANGE_API_KEY=

# Optional transit/routing provider (for example, a provider-issued transit key).
ROUTE_API_KEY=

# Google web OAuth credentials. Callback URLs are configured during stage 6.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple web sign-in credentials.
# For a multiline .p8 key, keep its line breaks inside double quotes.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=""

# Affiliate configuration: activate only after approval and verified link mapping.
AFFILIATE_CONFIG_PATH=
PROVIDER_A_PARTNER_ID=
PROVIDER_A_TRACKING_CODE=
PROVIDER_B_PARTNER_ID=
PROVIDER_B_TRACKING_CODE=

# PROVIDER_A - 트립닷컴
# Fill only issued fields; API_SECRET is optional depending on the provider.
PROVIDER_A_API_BASE_URL=
PROVIDER_A_API_KEY=
PROVIDER_A_API_SECRET=

# PROVIDER_B - 클룩
# Fill only issued fields; API_SECRET is optional depending on the provider.
PROVIDER_B_API_BASE_URL=
PROVIDER_B_API_KEY=
PROVIDER_B_API_SECRET=

# PROVIDER_C - 마이리얼트립
# Fill only issued fields; API_SECRET is optional depending on the provider.
PROVIDER_C_API_BASE_URL=
PROVIDER_C_API_KEY=
PROVIDER_C_API_SECRET=
PROVIDER_C_PARTNER_ID=
PROVIDER_C_TRACKING_CODE=

# PROVIDER_D - 아고다
# Fill only issued fields; API_SECRET is optional depending on the provider.
PROVIDER_D_API_BASE_URL=
PROVIDER_D_API_KEY=
PROVIDER_D_API_SECRET=
PROVIDER_D_PARTNER_ID=
PROVIDER_D_TRACKING_CODE=

# Local SQLite catalog (no rented database server required).
DATABASE_PATH=var/trip-fit.sqlite

# Busan import limits (optional; defaults shown, no credentials here).
ATTRACTION_TIMEOUT_MS=10000
ATTRACTION_CACHE_TTL_MS=3600000
ATTRACTION_MAX_PAGES=20

# Busan FoodService: server-only key; no VITE_ prefix.
FOOD_SERVICE_KEY=

# Busan RecommendedService: server only, no VITE_ prefix.
RECOMMENDED_SERVICE_KEY=

# Busan public parking: manual CLI collection; no page or public parking route.
PARKING_SERVICE_KEY=

# Optional parking CLI limits: defaults 15000ms, 100 pages, 100 rows/page.
PARKING_TIMEOUT_MS=
PARKING_MAX_PAGES=
PARKING_PAGE_SIZE=

# AWS/local persistent admin. Run npm run admin:setup locally; never expose these to Vite.
ADMIN_ENABLED=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Exact HTTPS origins in production, comma separated. No trailing slash.
ADMIN_ALLOWED_ORIGINS=
ADMIN_STORAGE_DIR=
# Extra approved HTTPS image hostnames, comma separated.
ADMIN_IMAGE_HOSTS=

# Optional public browser key: restrict to Maps Embed API and your exact website referrers.
# Keyless Google Maps route export works without this key.
GOOGLE_MAPS_EMBED_API_KEY=
