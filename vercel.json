{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "cd ../.. && npm run build --workspace @trip-fit/domain && npm run build --workspace @trip-fit/web",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        },
        {
          "source": "/search",
          "destination": "/index.html"
        },
        {
          "source": "/saved",
          "destination": "/index.html"
        },
        {
          "source": "/cart",
          "destination": "/index.html"
        },
        {
          "source": "/food/:path*",
          "destination": "/index.html"
        },
        {
          "source": "/recommended/:path*",
          "destination": "/index.html"
        },
        {
          "source": "/places/:path*",
          "destination": "/index.html"
        }
      ],
      "installCommand": "cd ../.. && npm ci --include=dev --workspaces --include-workspace-root"
    },
    "server": {
      "root": "apps/server",
      "framework": "fastify",
      "entrypoint": "src/app.ts",
      "buildCommand": "cd ../.. && npm run build --workspace @trip-fit/domain && npm run build --workspace @trip-fit/server",
      "functions": {
        "src/app.ts": {
          "includeFiles": "{../../config/catalog/**,../../data/snapshots/**}"
        }
      },
      "installCommand": "cd ../.. && npm ci --include=dev --workspaces --include-workspace-root"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
